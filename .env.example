# --- Server (AI evaluator). Leave ANTHROPIC_API_KEY empty to use the offline heuristic fallback. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
PORT=8787

# --- Web (Vite) ---
# Address printed by `npm run deploy:fuji`
VITE_REGISTRY_ADDRESS=
VITE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
# Comma-separated issuer wallets shown as "trusted issuer" (e.g. your organiser wallet)
VITE_TRUSTED_ISSUERS=
# Only needed when the API is hosted on another domain (e.g. https://skillpass-api.onrender.com)
VITE_API_URL=

# --- Deploy script only (throwaway testnet key!) ---
# PRIVATE_KEY=0x...
